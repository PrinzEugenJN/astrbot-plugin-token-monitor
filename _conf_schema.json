{
  "alert_enabled": {
    "description": "警告总开关",
    "type": "bool",
    "default": true
  },
  "alert_target_session": {
    "description": "警告发送目标会话",
    "type": "string",
    "default": "default:FriendMessage:256418297"
  },
  "check_interval_sec": {
    "description": "后端水位检查间隔（秒）",
    "type": "int",
    "default": 60
  },
  "refresh_interval_ms": {
    "description": "页面轮询间隔（毫秒）",
    "type": "int",
    "default": 10000
  },
  "alert_scope": {
    "description": "警告监控范围",
    "type": "string",
    "default": "main"
  },
  "alert_custom_sessions": {
    "description": "自定义会话 ID 列表",
    "type": "string",
    "default": ""
  },
  "alert_step_pct": {
    "description": "越阈值后再次告警上升%",
    "type": "int",
    "default": 5
  },
  "turn_alert_enabled": {
    "description": "轮数告警开关",
    "type": "bool",
    "default": true
  },
  "alert_turn_pct": {
    "description": "轮数告警阈值%",
    "type": "int",
    "default": 75
  },
  "turn_step_pct": {
    "description": "轮数越阈值后再告警上升%",
    "type": "int",
    "default": 5
  },
  "context_limit": {
    "description": "上下文上限（越高越晚触发告警）。留空或不填则自动按该模型的上下文/兜底值检测，非必填。",
    "type": "int",
    "default": 0
  },
  "stale_days": {
    "description": "会话冻结多少天后标记为旧会话（0=不标记）",
    "type": "int",
    "default": 30
  }
}